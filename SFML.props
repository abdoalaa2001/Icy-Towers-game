<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SFMLRoot Condition="'$(SFMLRoot)' == ''">$(MSBuildThisFileDirectory).sfml</SFMLRoot>
    <SFMLDir>$(SFMLRoot)\$(Platform)\SFML-2.6.2</SFMLDir>
    <LocalDebuggerWorkingDirectory>$(MSBuildThisFileDirectory)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SFMLDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(SFMLDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies Condition="'$(Configuration)' == 'Debug'">sfml-graphics-d.lib;sfml-window-d.lib;sfml-system-d.lib;sfml-audio-d.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)' == 'Release'">sfml-graphics.lib;sfml-window.lib;sfml-system.lib;sfml-audio.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /Y /I /Q "$(SFMLDir)\bin\*.dll" "$(TargetDir)" &gt;nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <Target Name="CheckSFML" BeforeTargets="PrepareForBuild" Condition="!Exists('$(SFMLDir)\include\SFML\Graphics.hpp')">
    <Error Text="SFML 2.6.2 is missing. Run setup-sfml.ps1 in this project directory first." />
  </Target>
</Project>
